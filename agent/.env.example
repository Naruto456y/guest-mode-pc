# ============================================================
# Конфигурация агента «Гостевой режим ПК»
# Скопируйте этот файл в .env и заполните значения.
# ============================================================

# --- Подключение к серверу управления ---
SERVER_URL=http://127.0.0.1:8000
# Секретный токен — должен СОВПАДАТЬ с AGENT_TOKEN в server/.env
AGENT_TOKEN=change_me_secret_token

# --- ТЕСТОВЫЙ РЕЖИМ ---
# true  -> ничего опасного не выполняется, только пишется в лог
#          ("[DRY_RUN] выключил бы ПК" и т.п.)
# false -> боевой режим, действия выполняются по-настоящему
#
# ВАЖНО: переключайте этот параметр только здесь, вручную, на этом ПК.
# С сайта управления изменить DRY_RUN нельзя — это сделано специально,
# чтобы никто не включил боевой режим удалённо.
DRY_RUN=true

# --- Интервалы (в секундах) ---
POLL_INTERVAL=1.0
STATUS_INTERVAL=5
SCREENSHOT_INTERVAL=12
HTTP_TIMEOUT=5

# --- Живая трансляция экрана (кнопка на сайте «Включить трансляцию») ---
STREAM_INTERVAL=0.05
STREAM_MAX_SECONDS=600

# --- Окно пароля ---
# Сколько секунд даётся на ввод пароля, прежде чем сработает автовыключение
PASSWORD_TIMEOUT=60

# Пароль гостевого окна открытым текстом — впишите свой
GUEST_PASSWORD=

# --- Аварийный выход ---
# Если этот файл появится на диске — агент немедленно снимает
# все блокировки и больше не показывает окно пароля, пока файл не удалят.
EMERGENCY_FLAG=C:\guest_mode_off.flag

# --- Белый список процессов для блокировки приложений (через запятую) ---
ALLOWED_PROCESSES=explorer.exe,dwm.exe,svchost.exe,csrss.exe,winlogon.exe,wininit.exe,services.exe,lsass.exe,taskhostw.exe,sihost.exe,fontdrvhost.exe,ctfmon.exe,RuntimeBroker.exe,ShellExperienceHost.exe,SearchHost.exe,StartMenuExperienceHost.exe,python.exe,pythonw.exe,conhost.exe

# --- Логирование ---
LOG_FILE=agent.log
