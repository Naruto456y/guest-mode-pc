# ============================================================
# Конфигурация сервера управления «Гостевой режим ПК»
# Скопируйте этот файл в .env и заполните значения.
# ============================================================

# --- Вход в веб-панель ---
# Пароль открытым текстом — впишите свой, никаких скриптов не нужно
ADMIN_PASSWORD=

# --- Токен агента ---
# Секретный токен, которым агент на ПК авторизуется при обращении к API.
# Должен СОВПАДАТЬ с AGENT_TOKEN в agent/.env. Придумайте длинную
# случайную строку (например: python -c "import secrets; print(secrets.token_hex(32))")
AGENT_TOKEN=change_me_secret_token

# --- Сессии сайта ---
# Секрет для подписи cookie входа на сайт. Тоже длинная случайная строка.
SESSION_SECRET=change_me_random_string

# --- Сеть ---
HOST=0.0.0.0
PORT=8000

# --- Прочее ---
LOG_FILE=server.log
# Через сколько секунд без сигнала от агента считать ПК офлайн
AGENT_ONLINE_TIMEOUT=20
# Сколько последних событий хранить в памяти для показа на сайте
LOG_HISTORY_SIZE=200
